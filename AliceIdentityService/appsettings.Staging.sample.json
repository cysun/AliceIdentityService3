{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ais3_staging;Username=ais3_staging;Password=CHANGE_ME"
  },
  "AllowedHosts": "ais3-stage.example.org",
  "Application": {
    "CertificateFolder": "/var/lib/ais3/certificates"
  },
  "OpenIddict": {
    "Issuer": "https://ais3-stage.example.org/"
  },
  "Email": {
    "AppUrl": "https://ais3-stage.example.org/",
    "SenderName": "Alice Identity Service Staging",
    "SenderEmail": "noreply@example.org"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "ais3-staging",
    "Password": "CHANGE_ME",
    "QueueName": "alice-mail-service-staging",
    "UseTls": false,
    "TlsServerName": "",
    "PublishTimeoutSeconds": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "OpenIddict": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
