@model AccountEmailLinkModel
<form asp-controller="Account" asp-action="ResetPassword" method="post" class="fields">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="OidcContext" />
    <div asp-validation-summary="All" class="validation-errors" role="alert"></div>
    <partial name="~/Views/Account/_NewPasswordFields.cshtml" />
    <button type="submit" class="primary-button">Reset password <span aria-hidden="true">→</span></button>
</form>
