@model RegistrationInputModel
<form asp-controller="Account" asp-action="Register" method="post" class="fields">
    <input type="hidden" asp-for="OidcContext" />
    <div asp-validation-summary="All" class="validation-errors" role="alert"></div>
    <div class="two-fields"><label class="field" for="first-name">First name<input asp-for="FirstName" id="first-name" autocomplete="given-name" required maxlength="255" /></label><label class="field" for="last-name">Last name<input asp-for="LastName" id="last-name" autocomplete="family-name" required maxlength="255" /></label></div>
    <label class="field" for="email">Email address<input asp-for="Email" id="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="256" /></label>
    <p>We'll email you a link to choose your password and activate your account.</p>
    <button type="submit" class="primary-button">Send confirmation email <span aria-hidden="true">→</span></button>
</form>
