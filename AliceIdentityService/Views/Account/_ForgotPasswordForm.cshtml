@model ForgotPasswordInputModel
<form asp-controller="Account" asp-action="ForgotPassword" method="post" class="fields">
    <input type="hidden" asp-for="OidcContext" />
    <div asp-validation-summary="All" class="validation-errors" role="alert"></div>
    <label class="field" for="email">Email address<input asp-for="Email" id="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="256" /></label>
    <button type="submit" class="primary-button">Send reset link <span aria-hidden="true">→</span></button>
</form>
