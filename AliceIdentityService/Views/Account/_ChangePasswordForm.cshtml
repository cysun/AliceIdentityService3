@model ChangePasswordInputModel
<form asp-controller="Account" asp-action="ChangePassword" method="post" class="fields">
    <div asp-validation-summary="All" class="validation-errors" role="alert"></div>
    <label class="field" for="current-password">Current password<input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" required maxlength="4096" /></label>
    <partial name="~/Views/Account/_NewPasswordFields.cshtml" />
    <button type="submit" class="primary-button">Change password</button>
    <a asp-controller="Account" asp-action="Home">Cancel</a>
</form>
