@model AccountPageModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@Model.Heading · Alice Identity Service</title>
    <link rel="icon" href="/brand/fingerprint.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/account.css" asp-append-version="true" />
    <script src="/js/account.js" defer asp-append-version="true"></script>
</head>
<body>
    <div class="preview-banner">
        <span><strong>AIS3 · Step 8</strong> Account features, the administration overview, and user search are connected.</span>
        <nav aria-label="Preview navigation">
            <a href="/Account/Login">Direct login</a>
            <a href="/admin/">Administration →</a>
        </nav>
    </div>
    <div class="account-shell @(Model.IsOidc ? "oidc" : "direct")">
        <header class="account-header">
            <a class="brand" href="/Account/Login"><span class="brand-mark"><img src="/brand/fingerprint.svg" alt="" width="24" height="24" /></span>Alice Identity Service</a>
            @if (!Model.IsOidc) { <span class="muted tagline">Your account. Your applications.</span> }
        </header>
        <main class="account-main">
            @if (!Model.IsOidc)
            {
                <section class="account-intro" aria-label="About Alice Identity Service">
                    <p class="eyebrow">Alice Identity Service</p>
                    <h1>One account.<br />More possibilities.</h1>
                    <p class="intro-copy">A familiar place to sign in, manage your account, and access the applications you use.</p>
                    <div class="connected-apps">
                        <div class="connected-app"><span class="app-initial">DP</span><div><strong>Department Portal</strong><small>Operations and records</small></div><span class="check" aria-hidden="true">✓</span></div>
                        <div class="connected-app"><span class="app-initial">AC</span><div><strong>Assessment Center</strong><small>Program review and assessment</small></div><span class="check" aria-hidden="true">✓</span></div>
                        <div class="connected-app"><span class="app-initial">OA</span><div><strong>Other Apps</strong><small>Exploration and experimentation</small></div><span class="check" aria-hidden="true">✓</span></div>
                    </div>
                </section>
            }
            <section class="account-panel" aria-labelledby="account-heading">
                <div class="account-title">
                    <h2 id="account-heading">@Model.Heading</h2>
                    @if (Model.IsOidc)
                    {
                        <p>@(Model.Page == "OidcLogout" ? "Requested by" : "to continue to") <strong>@Model.ApplicationName</strong></p>
                    }
                    else
                    {
                        <p>@(Model.Page switch
                        {
                            "Register" => "One account for your connected applications.",
                            "ResendConfirmation" => "Request a new link to confirm your email address.",
                            "CheckEmail" => "If this address needs confirmation, an email will arrive shortly. Check your spam folder too.",
                            "ConfirmEmail" => "One more step to activate your account.",
                            "EmailConfirmed" => "Your email is confirmed. You can now sign in.",
                            "ConfirmationInvalid" => "This link is invalid, expired, or already used. Sign in or request a new confirmation email.",
                            "MailUnavailable" => "We could not queue the confirmation email. Your account remains unconfirmed. Wait a minute, then request another email.",
                            "ForgotPassword" => "Enter your email to request a password reset link.",
                            "ResetPassword" => "Create a new password for your AIS account.",
                            "ChangePassword" => "Enter your current password and choose a new one. You will need to sign in again.",
                            "Home" => "Manage how your name appears in connected apps.",
                            "Logout" => "This will sign you out of AIS on this browser.",
                            "OidcLogout" => "Sign out of AIS on this browser?",
                            "InvalidRequest" => "This sign-in request is invalid or expired. Return to your application and start again.",
                            "AccessDenied" => "Administrator access is required to open this page.",
                            "ResetEmailSent" or "ResetInvalid" or "PasswordReset" or "PasswordChanged" => "",
                            _ => "Sign in to your AIS account."
                        })</p>
                    }
                </div>
                @if (Model.Page == "Login")
                {
                    <partial name="~/Views/Account/_LoginForm.cshtml" model="Model.Login" />
                }
                else if (Model.Page == "Register")
                {
                    <partial name="~/Views/Account/_RegistrationForm.cshtml" model="Model.Registration" />
                }
                else if (Model.Page == "ResendConfirmation")
                {
                    <partial name="~/Views/Account/_ResendConfirmationForm.cshtml" model="Model.Resend" />
                }
                else if (Model.Page == "ConfirmEmail")
                {
                    <partial name="~/Views/Account/_ConfirmEmailForm.cshtml" model="Model.Confirmation" />
                }
                else if (Model.Page is "CheckEmail" or "MailUnavailable" or "ConfirmationInvalid")
                {
                    <div class="fields">
                        @if (Model.IsOidc)
                        {
                            <p>@(Model.Page == "MailUnavailable" ? "We could not queue the confirmation email. Your account remains unconfirmed. Wait a minute, then request another email." : "If this address needs confirmation, an email will arrive shortly. Check your spam folder too.")</p>
                        }
                        <p>Confirmation links expire after 24 hours. Resends are limited to one per minute and five per hour.</p>
                        <a asp-controller="Account" asp-action="ResendConfirmation" asp-route-context="@Model.OidcContext">Request another confirmation email</a>
                        <a asp-controller="Account" asp-action="Login" asp-route-context="@Model.OidcContext">Back to sign in</a>
                    </div>
                }
                else if (Model.Page == "EmailConfirmed")
                {
                    <div class="fields">
                        @if (Model.ContinuationExpired)
                        {
                            <p>Your email is confirmed, but your application sign-in request has expired. Return to your application and start sign-in again.</p>
                        }
                        else if (Model.IsOidc)
                        {
                            <p>Your email is confirmed. Sign in to continue to your application.</p>
                        }
                        <a class="primary-button" asp-controller="Account" asp-action="Login" asp-route-context="@Model.OidcContext">Continue to sign in <span aria-hidden="true">→</span></a>
                    </div>
                }
                else if (Model.Page == "Home")
                {
                    <div class="fields">
                        @if (Model.ProfileSaved) { <p class="account-notice" role="status">Your profile has been saved.</p> }
                        <partial name="~/Views/Account/_ProfileForm.cshtml" model="Model.Profile" />
                        <a asp-action="ChangePassword">Change password</a>
                        @if (User.HasClaim(claim => claim.Type == AisConstants.AdminClaim))
                        {
                            <a class="primary-button" href="/admin/">Open administration <span aria-hidden="true">→</span></a>
                        }
                        <form asp-action="SignOutAccount" method="post" class="fields"><button class="primary-button" type="submit">Sign out</button></form>
                    </div>
                }
                else if (Model.Page == "Logout")
                {
                    <form asp-action="SignOutAccount" method="post" class="fields">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button class="primary-button" type="submit">Sign out</button>
                        <a asp-action="Home">Stay signed in</a>
                    </form>
                }
                else if (Model.Page == "OidcLogout")
                {
                    <form action="/connect/logout" method="post" class="fields">
                        @Html.AntiForgeryToken()
                        @foreach (var parameter in Model.LogoutParameters)
                        {
                            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
                        }
                        <button class="primary-button" type="submit" name="confirm" value="yes">Sign out</button>
                        <a href="/Account">Cancel</a>
                    </form>
                }
                else if (Model.Page == "InvalidRequest")
                {
                    <a href="/Account/Login">Go to direct sign-in</a>
                }
                else if (Model.Page == "AccessDenied")
                {
                    <div class="fields"><a asp-action="Home">Back to your account</a>
                    @if (User.Identity?.IsAuthenticated == true) { <a asp-action="Logout">Sign out to use another account</a> }
                    </div>
                }
                else if (Model.Page == "ForgotPassword")
                {
                    <partial name="~/Views/Account/_ForgotPasswordForm.cshtml" model="Model.ForgotPassword" />
                }
                else if (Model.Page == "ResetPassword")
                {
                    <partial name="~/Views/Account/_ResetPasswordForm.cshtml" model="Model.ResetPassword" />
                }
                else if (Model.Page == "ChangePassword")
                {
                    <partial name="~/Views/Account/_ChangePasswordForm.cshtml" model="Model.ChangePassword" />
                }
                else if (Model.Page is "ResetEmailSent" or "ResetInvalid")
                {
                    <div class="fields">
                        <p>@(Model.Page == "ResetInvalid" ? "This link is invalid, expired, or already used. Request a new password reset link." : "If this address belongs to an eligible confirmed account, you will receive a password reset link. Check your spam folder too.")</p>
                        <p>Reset links expire after one hour. If the email does not arrive, wait a minute before trying again.</p>
                        <a asp-action="ForgotPassword" asp-route-context="@Model.OidcContext">Request another reset link</a>
                        <a asp-action="Login" asp-route-context="@Model.OidcContext">Back to sign in</a>
                    </div>
                }
                else if (Model.Page is "PasswordReset" or "PasswordChanged")
                {
                    <div class="fields">
                        <p>Your password has been updated. Sign in again with your new password. Other AIS browser sessions will also need to sign in again.</p>
                        @if (Model.ContinuationExpired)
                        {
                            <p>Your application sign-in request has expired. Return to your application and start sign-in again.</p>
                        }
                        <a class="primary-button" asp-action="Login" asp-route-context="@Model.OidcContext">Continue to sign in <span aria-hidden="true">→</span></a>
                    </div>
                }
                @if (Model.Page is "Login" or "Register" or "ForgotPassword" or "ResendConfirmation" or "ResetPassword")
                {
                    <div class="account-panel-footer">
                        @if (Model.Page == "Login")
                        {
                            <span>New to AIS? <a asp-controller="Account" asp-action="Register" asp-route-context="@Model.OidcContext">Create an account</a></span>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-context="@Model.OidcContext">← Back to sign in</a>
                        }
                    </div>
                }
            </section>
        </main>
        <footer class="account-footer"><span>© @DateTime.UtcNow.Year Alice Identity Service</span>@if (!Model.IsOidc) { <span>One place to manage your identity</span> }</footer>
    </div>
</body>
</html>
