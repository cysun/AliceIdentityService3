@model AccountPreviewModel
@{
    Layout = null;
    var contextPreview = Model.IsOidc ? "oidc" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@Model.Heading · Alice Identity Service</title>
    <link rel="icon" href="/brand/fingerprint.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/account.css" asp-append-version="true" />
    <script src="/js/account.js" defer asp-append-version="true"></script>
</head>
<body>
    <div class="preview-banner">
        <span><strong>AIS3 · Step 2</strong> Interface preview — authentication is not connected. Use sample values only.</span>
        <nav aria-label="Preview navigation">
            <a href="/Account/Login">Direct login</a>
            <a href="/Account/Login?preview=oidc&amp;app=campus-portal">OIDC login</a>
            <a href="/admin/">Admin preview →</a>
        </nav>
    </div>
    <div class="account-shell @(Model.IsOidc ? "oidc" : "direct")">
        <header class="account-header">
            <a class="brand" href="/Account/Login"><span class="brand-mark"><img src="/brand/fingerprint.svg" alt="" width="24" height="24" /></span>Alice Identity Service</a>
            @if (!Model.IsOidc) { <span class="muted tagline">Your account. Your applications.</span> }
        </header>
        <main class="account-main">
            @if (!Model.IsOidc)
            {
                <section class="account-intro" aria-label="About Alice Identity Service">
                    <p class="eyebrow">Alice Identity Service</p>
                    <h1>One account.<br />More possibilities.</h1>
                    <p class="intro-copy">A familiar place to sign in, manage your account, and access the applications you use.</p>
                    <div class="connected-apps">
                        <div class="connected-app"><span class="app-initial">DP</span><div><strong>Department Portal</strong><small>Operations and records</small></div><span class="check" aria-hidden="true">✓</span></div>
                        <div class="connected-app"><span class="app-initial">AC</span><div><strong>Assessment Center</strong><small>Program review and assessment</small></div><span class="check" aria-hidden="true">✓</span></div>
                        <div class="connected-app"><span class="app-initial">OA</span><div><strong>Other Apps</strong><small>Exploration and experimentation</small></div><span class="check" aria-hidden="true">✓</span></div>
                    </div>
                </section>
            }
            <section class="account-panel" aria-labelledby="account-heading">
                <div class="account-title">
                    <h2 id="account-heading">@Model.Heading</h2>
                    @if (Model.IsOidc)
                    {
                        <p>to continue to <strong>@Model.ApplicationName</strong></p>
                    }
                    else
                    {
                        <p>@(Model.Page == "Register" ? "One account for your connected applications." : Model.Page == "ForgotPassword" ? "Enter your email to request a password reset link." : "Sign in to your AIS account.")</p>
                    }
                </div>
                <div class="fields">
                    @if (Model.Page == "Register")
                    {
                        <div class="two-fields"><label class="field" for="first-name">First name<input id="first-name" autocomplete="off" /></label><label class="field" for="last-name">Last name<input id="last-name" autocomplete="off" /></label></div>
                    }
                    <label class="field" for="email">Email address<input id="email" type="email" autocomplete="off" placeholder="you@example.com" /></label>
                    @if (Model.Page != "ForgotPassword")
                    {
                        <div class="field"><label for="password">Password</label><span class="password-field"><input id="password" type="password" autocomplete="new-password" placeholder="Enter your password" /><button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">Show</button></span></div>
                    }
                    @if (Model.Page == "Register")
                    {
                        <label class="field" for="confirm-password">Confirm password<input id="confirm-password" type="password" autocomplete="new-password" placeholder="Re-enter your password" /></label>
                    }
                    @if (Model.Page == "Login")
                    {
                        <div class="form-options"><label class="checkbox"><input type="checkbox" />Remember me</label><a asp-action="ForgotPassword" asp-route-preview="@contextPreview" asp-route-app="@Model.AppKey">Forgot password?</a></div>
                    }
                    <button type="button" class="primary-button" data-preview-action>@(Model.Page == "Register" ? "Create account" : Model.Page == "ForgotPassword" ? "Send reset link" : "Sign in") <span aria-hidden="true">→</span></button>
                    <p class="preview-result" role="status" hidden>This is a visual preview. No account request was sent.</p>
                </div>
                <div class="account-panel-footer">
                    @if (Model.Page == "Login")
                    {
                        <span>New to AIS? <a asp-action="Register" asp-route-preview="@contextPreview" asp-route-app="@Model.AppKey">Create an account</a></span>
                    }
                    else
                    {
                        <a asp-action="Login" asp-route-preview="@contextPreview" asp-route-app="@Model.AppKey">← Back to sign in</a>
                    }
                </div>
            </section>
        </main>
        <footer class="account-footer"><span>© @DateTime.UtcNow.Year Alice Identity Service</span>@if (!Model.IsOidc) { <span>One place to manage your identity</span> }</footer>
    </div>
</body>
</html>
