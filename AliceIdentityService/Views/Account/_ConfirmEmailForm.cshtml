@model ConfirmEmailInputModel
<form asp-controller="Account" asp-action="ConfirmEmail" method="post" class="fields">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="OidcContext" />
    <p>Confirm that you requested this account and want to use this email address with Alice Identity Service.</p>
    <button type="submit" class="primary-button">Confirm email <span aria-hidden="true">→</span></button>
</form>
