{
  "Application": {
    "CertificateFolder": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ais3;Username=YOUR_DATABASE_USER;Password=CHANGE_ME"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:7443/"
  },
  "Email": {
    "AppUrl": "https://localhost:7443/",
    "SenderName": "Alice Identity Service",
    "SenderEmail": "noreply@example.test"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "alice-mail-service",
    "UseTls": false,
    "TlsServerName": "",
    "PublishTimeoutSeconds": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ais-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
